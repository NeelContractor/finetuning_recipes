# Copy this file to `.env` and fill in the values you need.
#
# Most scripts read plain environment variables (they do not auto-load `.env`),
# so either export them in your shell:
#
#   set -a; source .env; set +a
#
# or run the cloud orchestrator, which loads `.env` for you:
#
#   python cloud_train.py --env-file .env ...

# ---------------------------------------------------------------------------
# OpenRouter (free LLM judge / ranking / data augmentation)
# ---------------------------------------------------------------------------
# Used by:
#   instruction_tuning/api_inference.py
#   instruction_tuning/llm_judge.py
#   instruction_tuning/llm_comparison_judge.py
#   preference_optimization/generate_ranked_pairs_openai.py
#   preference_optimization/diversity_evals/llm_diversity_judge.py
#   data_prep/augment_5star.py
#   data_prep/generate_confounds.py
#   data_prep/reasoning/add_reasoning.py   (with --provider openrouter)
#   cloud_train.py                         (with --dpo-source generate)
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------------
# OpenAI-compatible provider (used by data_prep/reasoning/add_reasoning.py)
# ---------------------------------------------------------------------------
# Only needed for `--provider openai` (the default). Set OPENAI_BASE_URL to
# point at any OpenAI-compatible server (vLLM, Ollama, LM Studio, etc.).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# text-albumentations data generation
# ---------------------------------------------------------------------------
# Used by data_prep/instruction/* and data_prep/reasoning/add_reasoning.py.
LLM_PROVIDER=openai
TEXT_ALBUMENTATIONS_MODEL=gpt-5-mini
# One of: none | minimal | low | medium | high | xhigh | disabled
TEXT_ALBUMENTATIONS_REASONING_EFFORT=low

# ---------------------------------------------------------------------------
# Optional: Hugging Face
# ---------------------------------------------------------------------------
# Not read explicitly by this repo, but transformers/datasets use it
# automatically for higher rate limits or gated repos.
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
